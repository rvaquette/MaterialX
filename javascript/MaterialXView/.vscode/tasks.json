{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "webpack-serve",
            "type": "shell",
            "command": "npm run start",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "ERROR in (.*)",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "webpack",
                    "endsPattern": "compiled|failed"
                }
            }
        }
    ]
}
